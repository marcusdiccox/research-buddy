{
  "name": "research-buddy",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "A cozy desktop research companion with notes, reminders, and calendar helpers.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "make": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run build && electron-builder --win dir --x64 --publish never",
    "make:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "pack:mac": "npm run build && electron-builder --mac dir --publish never"
  },
  "build": {
    "artifactName": "Pip-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "marcusdiccox",
        "repo": "research-buddy",
        "releaseType": "release"
      }
    ],
    "appId": "com.researchbuddy.desktop",
    "productName": "Research Buddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/pip.ico",
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Pip-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/pip.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Copy selected text only when you use Pip’s capture shortcut."
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
